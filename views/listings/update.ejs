<% layout("layouts/boilerplate.ejs")-%>
<form method="post" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
<div class="row mt-3">
<div class="col-8 offset-2">
 <h1>Edit this listing</h1>
<div class="mb-3">
<label for="title" class="form-label">Title</label>
<input type="text"  name="title"  class="form-control" value="<%= listing.title%>" required>
<div class="invalid-feedback">Please Enter title</div>
</div>
 <div class="mb-3">
<label for="description" class="form-label">Description</label>
<textarea required  name="description" rows="8" cols="23" class="form-control"><%= listing.description%></textarea>
<div class="invalid-feedback">Please Enter description</div>
</div>
<h3>Original listing image</h3>
<img src="<%=newimageUrl%>">
 <div class="mb-3">
<label for="image" class="form-label">Upload Image</label>
<input type="file"  name="image" class="form-control">
<div class="invalid-feedback">Please Upload image</div>
</div>
<div class="row">
 <div class=" mb-3 col-4">
<label for="price" class="form-label">Price</label>
<input type="number"  name="price" class="form-control" value="<%= listing.price%>"required>
<div class="invalid-feedback">Please Enter price</div>
</div>
 <div class="mb-3 col-md-8 ">
<label for="country" class="form-label">Country</label>
<input type="text"  name="country" class="form-control" value="<%= listing.country%>"required>
<div class="invalid-feedback">Please Enter country</div>
</div>
</div>
 <div class="mb-3">
<label for="location" class="form-label">Location</label>
<input type="text"  name="location" class="form-control" value="<%= listing.location%>"required>
<div class="invalid-feedback">Please Enter location</div>
</div>
<button class="btn btn-dark mt-2 btn-edit">Edit</button>
</div>
</div>
</form>