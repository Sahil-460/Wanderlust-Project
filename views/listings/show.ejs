<% layout('/layouts/boilerplate') -%>
<body>
  <div class="row">
    <div class="col-8 offset-3">
        <h2 style="color:aqua"><%= listing.title%></h2>
    </div>
  </div>
<div class="row">
<div class="card col-6 offset-3 show-card">
  <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
  <p>Owned By : <b><%=listing.owner.username%></b></p>
  <p><%= listing.description%></p>
  <p>&#8377; <%= listing.price%></p>
  <p><%= listing.location%></p>
  <p><%= listing.country%></p>
  <%if(curruser&&curruser._id.equals(listing.owner._id)){%>
  <div class="col-1 mb-3">
    <a href="/listings/<%= listing._id%>/edit" style="text-decoration: none;font-size:18px;" class="btn btn-dark btn-edit">Edit</a><br>
  </div>
  <div class="col-1">
    <form method="post" action="/listings/<%= listing._id%>?_method=DELETE">
  <button style="font-size: 15px;" class="btn btn-dark">Delete</button>
  </div>
  <%}%>
</div>
</div>
</form>
<div class="row">
  <div class="col-8 offset-3">
  <%if(curruser){%>
  <h4>Leave a review</h4>
<form method="post" action="/listings/<%=listing._id%>/reviews" class="needs-validation" novalidate>
   <div class="mb-2 mt-3">
    <label for="rating" class="form-label">Rating</label>
  <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
  <div class="mb-3">
  <label for="comment" class="form-label">Comments</label><br>
  <textarea id="comment" cols="10" rows="8" name="review[comment]" class="form-control" required></textarea>
  <div class="invalid-feedback">Please submit some comments for review</div>
  </div>
  <button type="submit" class="btn btn-outline-dark ">Submit</button>
</form>
<%}%>
<hr>
<%if(listing.reviews.length){%><h4><b>All reviews</b></h4><%}%>
  <div class="row">
<%for(list of listing.reviews){%>
<div class="listing-card col-6 mb-3 ms-3" style="width: 18rem;">
  <div class="card-body">
    <h5 class="card-title mb-1">@<%=list.author.username%></h5>
      <p class="starability-result card-text" data-rating="<%=list.rating%>"></p>
    <p class="card-text mt-2"><%=list.comment%></p>
      <form action="/listings/<%=listing._id%>/reviews/<%=list._id%>?_method=DELETE" method="post" class="mb-2 mt-2">
       <%if(curruser&&curruser._id.equals(list._id)){%><button class="btn btn-dark btn-sm">Delete</button><%}%>
  </form>
  </div>
</div>
 <%}%>
</div>
<h1 class="mb-3">Where you'll be</h1>
<h4 class="mb-3"><%=listing.location%> , <%=listing.country%></h4>
</div>
 <div id="map" class="offset-3"></div>
</div>
</body>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
  const latitude = "<%=listing.latitude%>"
  const longitude = "<%=listing.longitude%>"
  const title="<%=listing.title%>"
  map = L.map('map').setView([latitude,longitude], 11); // lat, lon, zoom
  // Add OpenStreetMap tiles
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);
  // Optional marker
  L.marker([parseFloat(latitude),parseFloat(longitude)]).addTo(map)
    .bindPopup(`<b>${title}</b><br>Exact location after booking`)
    .openPopup();
    var circle = L.circle([parseFloat(latitude),parseFloat(longitude)], {
    color: 'red',
    fillColor: '#f03',
    fillOpacity: 0.35,
    radius: 500
}).addTo(map);
var popup = L.popup();

function onMapClick(e) {
    popup
        .setLatLng(e.latlng)
        .setContent("You clicked the map at " + e.latlng.toString())
        .openOn(map);
}
map.on('click', onMapClick);
    </script>  
